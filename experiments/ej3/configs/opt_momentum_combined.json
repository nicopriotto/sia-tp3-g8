{
  "name": "opt_momentum_combined",
  "model_type": "mlp",
  "architecture": [784, 128, 10],
  "activation": "tanh",
  "output_activation": "softmax",
  "loss": "categorical_cross_entropy",
  "task_type": "multiclass",
  "optimizer": "momentum",
  "optimizer_params": {"momentum": 0.9},
  "learning_rate": 0.05,
  "epochs": 80,
  "batch_size": 64,
  "seed": 42,
  "validation_ratio": 0.2,
  "early_stopping": true,
  "patience": 15,
  "min_delta": 0.0,
  "log_every": 1,
  "train_data": "data/digits.csv+more_digits.csv",
  "test_data": "data/digits_test.csv",
  "extra": {
    "data_strategy": "combined"
  }
}
