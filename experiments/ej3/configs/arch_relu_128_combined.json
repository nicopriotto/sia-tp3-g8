{
  "name": "arch_relu_128_combined",
  "model_type": "mlp",
  "architecture": [784, 128, 10],
  "activation": "relu",
  "output_activation": "softmax",
  "loss": "categorical_cross_entropy",
  "task_type": "multiclass",
  "weight_init": "he",
  "optimizer": "adam",
  "optimizer_params": {"beta1": 0.9, "beta2": 0.999, "epsilon": 1e-8},
  "learning_rate": 0.001,
  "epochs": 50,
  "batch_size": 64,
  "seed": 42,
  "validation_ratio": 0.2,
  "early_stopping": true,
  "patience": 10,
  "min_delta": 0.0,
  "log_every": 1,
  "train_data": "data/digits.csv+more_digits.csv",
  "test_data": "data/digits_test.csv",
  "extra": {
    "data_strategy": "combined"
  }
}
